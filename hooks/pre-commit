#!/bin/bash
# 仕組み化: server.ts変更時のバージョン+構文チェック
# のりさん指示 2026-04-12
# 「バージョン管理クビだよ」「仕組み化してこれ起きたらクビ」「今後こういうミスが起きないように仕組み化して」

# server.tsがステージングされてるか確認
if git diff --cached --name-only | grep -q "server.ts"; then

  # ===== チェック1: バージョン番号 =====
  if ! git diff --cached --name-only | grep -q "plugin.json"; then
    echo ""
    echo "⛔⛔⛔ コミット拒否: server.ts変更時はplugin.jsonのバージョンも上げろ！"
    echo ""
    echo "修正手順:"
    echo "  1. .claude-plugin/plugin.json の version を上げる"
    echo "  2. git add .claude-plugin/plugin.json"
    echo "  3. 再度 git commit"
    echo ""
    exit 1
  fi

  OLD_VER=$(git show HEAD:.claude-plugin/plugin.json 2>/dev/null | grep '"version"' | sed -n 's/.*"\([0-9]*\.[0-9]*\.[0-9]*\)".*/"\1"/p')
  NEW_VER=$(cat .claude-plugin/plugin.json | grep '"version"' | sed -n 's/.*"\([0-9]*\.[0-9]*\.[0-9]*\)".*/"\1"/p')

  if [ "$OLD_VER" = "$NEW_VER" ]; then
    echo ""
    echo "⛔⛔⛔ コミット拒否: plugin.jsonのバージョン番号が変わっていない！"
    echo ""
    echo "現在: $OLD_VER → 新しいバージョンに上げてください"
    echo ""
    exit 1
  fi

  echo "✅ バージョンチェックOK: $OLD_VER → $NEW_VER"

  # ===== チェック2: 構文チェック（bun） =====
  # ステージングされたserver.tsを一時ファイルに展開して構文検証
  TMPFILE=$(mktemp /tmp/server-check-XXXXXX.ts)
  git show :server.ts > "$TMPFILE" 2>/dev/null

  if [ -s "$TMPFILE" ]; then
    # bunで構文チェック（--dry-runで実行せずチェックのみ）
    SYNTAX_ERROR=$(bun build "$TMPFILE" --target=bun 2>&1 | grep -i "error\|SyntaxError" | head -5)
    rm -f "$TMPFILE"

    if [ -n "$SYNTAX_ERROR" ]; then
      echo ""
      echo "⛔⛔⛔ コミット拒否: server.ts に構文エラーがあります！"
      echo ""
      echo "$SYNTAX_ERROR"
      echo ""
      echo "修正してから再度 git add && git commit してください"
      echo ""
      exit 1
    fi
    echo "✅ 構文チェックOK"
  else
    rm -f "$TMPFILE"
  fi
fi
