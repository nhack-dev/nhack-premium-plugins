#!/bin/bash
# 仕組み化: server.ts変更時のバージョン+構文チェック
# 運用ルール
# 「バージョン管理クビだよ」「仕組み化してこれ起きたらクビ」「今後こういうミスが起きないように仕組み化して」

# server.tsがステージングされてるか確認
if git diff --cached --name-only | grep -q "server.ts"; then

  # ===== チェック1: バージョン番号 =====
  if ! git diff --cached --name-only | grep -q "plugin.json"; then
    echo ""
    echo "⛔⛔⛔ コミット拒否: server.ts変更時はplugin.jsonのバージョンも上げろ！"
    echo ""
    echo "修正手順:"
    echo "  1. .claude-plugin/plugin.json の version を上げる"
    echo "  2. git add .claude-plugin/plugin.json"
    echo "  3. 再度 git commit"
    echo ""
    exit 1
  fi

  OLD_VER=$(git show HEAD:.claude-plugin/plugin.json 2>/dev/null | grep '"version"' | sed -n 's/.*"\([0-9]*\.[0-9]*\.[0-9]*\)".*/"\1"/p')
  NEW_VER=$(cat .claude-plugin/plugin.json | grep '"version"' | sed -n 's/.*"\([0-9]*\.[0-9]*\.[0-9]*\)".*/"\1"/p')

  if [ "$OLD_VER" = "$NEW_VER" ]; then
    echo ""
    echo "⛔⛔⛔ コミット拒否: plugin.jsonのバージョン番号が変わっていない！"
    echo ""
    echo "現在: $OLD_VER → 新しいバージョンに上げてください"
    echo ""
    exit 1
  fi


  echo "✅ バージョンチェックOK: $OLD_VER → $NEW_VER"

  # ===== チェック2: 構文チェック（bun） =====
  # ステージングされたserver.tsを一時ファイルに展開して構文検証
  TMPFILE=$(mktemp /tmp/server-check-XXXXXX.ts)
  git show :server.ts > "$TMPFILE" 2>/dev/null

  if [ -s "$TMPFILE" ]; then
    # TypeScript構文チェック（依存関係不要・パース時のSyntaxErrorのみ検知）
    SYNTAX_ERROR=$(bun run --bun "$TMPFILE" 2>&1 | grep -i "SyntaxError\|Syntax Error" | head -5)
    rm -f "$TMPFILE"

    if [ -n "$SYNTAX_ERROR" ]; then
      echo ""
      echo "⛔⛔⛔ コミット拒否: server.ts に構文エラーがあります！"
      echo ""
      echo "$SYNTAX_ERROR"
      echo ""
      echo "修正してから再度 git add && git commit してください"
      echo ""
      exit 1
    fi
    echo "✅ 構文チェックOK"
  else
    rm -f "$TMPFILE"
  fi
fi

# 版が2箇所にある。片方だけ上げると、配っても更新が始まらない。
#   実測 2026-09-07: package.json だけ上げて2回配り、どちらも届かなかった。
#   更新の判定は .claude-plugin/plugin.json だけを見ている（server.ts 372/658/660行）。
#   「揃える」は次もずれるので、ずれたら進めない形にする。
PLUGIN_VER=$(python3 -c "import json;print(json.load(open('.claude-plugin/plugin.json'))['version'])" 2>/dev/null)
PKG_VER=$(python3 -c "import json;print(json.load(open('package.json')).get('version',''))" 2>/dev/null)
if [ -n "$PKG_VER" ] && [ "$PLUGIN_VER" != "$PKG_VER" ]; then
  echo ""
  echo "⛔⛔⛔ コミット拒否: 版が2箇所でずれています"
  echo "   .claude-plugin/plugin.json … $PLUGIN_VER  ← ★こちらが正本（更新の判定はここだけ見ます）"
  echo "   package.json ………… $PKG_VER"
  echo ""
  echo "   package.json を $PLUGIN_VER に合わせてください:"
  echo "     python3 -c \"import json;p='package.json';d=json.load(open(p));d['version']='$PLUGIN_VER';open(p,'w').write(json.dumps(d,indent=2,ensure_ascii=False)+chr(10))\""
  echo ""
  exit 1
fi
